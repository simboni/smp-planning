# StackUp environment (local development defaults).
# Runtime API role — NOBYPASSRLS, so PostgreSQL row-level security binds every query.
APP_DB_URL=postgres://stackup_app:app_dev_pw@localhost:5432/stackup_dev
# Schema-owning migration role — used ONLY by the migration runner.
ADMIN_DB_URL=postgres://stackup_migrator:migrator_dev_pw@localhost:5432/stackup_dev

# Database TLS. Certs are VERIFIED by default for non-local hosts. If your
# provider uses a private CA, set DB_SSL_CA to the CA PEM (inline or a path).
# DB_SSL_INSECURE=1 disables verification (encrypted but unauthenticated) — a
# last resort only. DB_SSL=disable|require forces TLS off/on.
# DB_SSL_CA=
# DB_SSL_INSECURE=

# Auth. In production JWT_SECRET MUST be set to a strong random value of at
# least 32 bytes — the app refuses to start otherwise. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=dev-only-change-me-in-production
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=2592000

# API
PORT=3000
NODE_ENV=development

# Browser origins allowed to call the API (CORS) AND to appear in the CSP
# connect-src, comma-separated. Only needed for split web/API origins; the
# single-origin deploy works without it.
# WEB_ORIGINS=https://app.example.com

# Outbound webhooks are https-only and blocked from private/loopback hosts
# (SSRF guard). Set to 1 ONLY for local dev to allow http/localhost targets.
# WEBHOOK_ALLOW_INSECURE_TARGETS=

# Web -> API base URL (browser). Empty = same-origin.
NEXT_PUBLIC_API_URL=http://localhost:3000
